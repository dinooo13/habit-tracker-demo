{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)"
    ],
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:unit *)",
      "Bash(npx vitest *)",
      "Bash(PORT=3110 E2E_PORT=3110 npm run test:e2e)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/gates-on-stop.sh",
            "timeout": 180,
            "statusMessage": "gates-on-stop: lint and unit tests"
          }
        ]
      }
    ]
  }
}
